# Copy to .env (not loaded automatically) or export these in your shell.
DJANGO_DEBUG=true
# Required whenever DJANGO_DEBUG is not true. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Comma-separated scheme+host list, needed for admin logins behind HTTPS.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Production-only switches (ignored while DJANGO_DEBUG=true).
DJANGO_SECURE_COOKIES=true
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_BEHIND_TLS_PROXY=false

GRAPHQL_API_URL=https://api.taomarketcap.com/graphql
GRAPHQL_SUBNET_UID=18
GRAPHQL_REQUEST_TIMEOUT=10
GRAPHQL_CACHE_SECONDS=300
GRAPHQL_MAX_RESPONSE_BYTES=5000000
